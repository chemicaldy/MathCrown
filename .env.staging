# Staging Firebase project — create "mathcrown-staging" in the Firebase
# console, register a Web App, and paste its config here (see docs/RUNBOOK.md).
VITE_FIREBASE_API_KEY=REPLACE_WITH_STAGING_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=mathcrown-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mathcrown-staging
VITE_FIREBASE_STORAGE_BUCKET=mathcrown-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_STAGING_APP_ID
VITE_USE_EMULATORS=false
VITE_ENV_LABEL=staging
