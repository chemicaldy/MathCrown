# Firebase web app config (public identifiers, NOT secrets — but each
# environment has its own). Copy per-environment values into
# .env.staging / .env.production, or .env.local for ad-hoc overrides.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" to point the app at local Firebase emulators (dev only)
VITE_USE_EMULATORS=false

# UI flags
VITE_ENV_LABEL=
