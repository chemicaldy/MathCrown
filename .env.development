# Local development — runs entirely against the Firebase emulator suite.
# `npm run emulators` in one terminal, `npm run dev` in another.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mathcrown.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mathcrown
VITE_FIREBASE_STORAGE_BUCKET=demo-mathcrown.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
VITE_USE_EMULATORS=true
VITE_ENV_LABEL=dev
