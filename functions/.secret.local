# DUMMY values for the local Firebase emulator suite ONLY — never real keys.
# Real secrets are set per-project with `firebase functions:secrets:set`.
# STRIPE_* here let the billing tests exercise signature verification and the
# entitlement flow end-to-end against the emulator.
STRIPE_SECRET_KEY=sk_test_dummy_local_emulator_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_local_emulator_secret
ANTHROPIC_API_KEY=
